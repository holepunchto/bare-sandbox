{
  "name": "bare-sandbox",
  "version": "0.1.1",
  "description": "Process sandboxing for JavaScript",
  "exports": {
    "./package": "./package.json",
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./errors": {
      "types": "./lib/errors.d.ts",
      "default": "./lib/errors.js"
    }
  },
  "imports": {
    "#backend": {
      "darwin": "./lib/seatbelt.js",
      "linux": "./lib/landlock.js",
      "win32": "./lib/psec.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "binding.c",
    "binding.js",
    "CMakeLists.txt",
    "lib",
    "prebuilds"
  ],
  "addon": true,
  "scripts": {
    "format": "prettier --write . && lunte --fix",
    "lint": "prettier --check . && lunte",
    "test": "brittle-bare test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holepunchto/bare-sandbox.git"
  },
  "author": "Holepunch",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/holepunchto/bare-sandbox/issues"
  },
  "homepage": "https://github.com/holepunchto/bare-sandbox#readme",
  "dependencies": {
    "bare-events": "^2.9.2",
    "bare-fs": "^4.8.5",
    "bare-os": "^3.9.4",
    "bare-path": "^3.1.3",
    "bare-pipe": "^4.4.0"
  },
  "devDependencies": {
    "bare-runtime": "^1.38.0",
    "bare-subprocess": "^6.2.2",
    "bare-tcp": "^2.6.1",
    "brittle": "^4.6.0",
    "cmake-bare": "^1.18.0",
    "lunte": "^1.8.6",
    "prettier": "^3.10.1",
    "prettier-config-holepunch": "^2.0.0",
    "tt-native": "^1.3.0"
  }
}
